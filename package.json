{
  "name": "@arcnosixta/squeeze",
  "version": "0.1.0",
  "description": "Lossless token compression for coding agents. Drop-in proxy + CLI that cuts prompt tokens on logs, compiler output and repeated tool results (measured up to 70% on real tsc output, 45% on real failing test runs). Zero dependencies.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcnosixta/squeeze.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "squeeze": "dist/cli/main.js",
    "squeeze-mcp": "dist/mcp/server.js"
  },
  "exports": {
    ".": "./dist/core/compress.js",
    "./proxy": "./dist/proxy/server.js",
    "./mcp": "./dist/mcp/server.js",
    "./store": "./dist/core/stats.js"
  },
  "files": [
    "dist",
    "src",
    "scripts",
    "fixtures/real",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node_modules/.bin/tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "bench": "node src/cli/main.ts bench",
    "selftest": "node src/cli/main.ts selftest",
    "doctor": "node src/cli/main.ts doctor",
    "serve": "node src/cli/main.ts serve",
    "test": "node --test test/*.test.ts",
    "test:proxy": "./scripts/test-proxy.sh",
    "test:mcp": "./scripts/test-mcp.sh",
    "test:persistence": "./scripts/test-persistence.sh",
    "mcp": "node src/mcp/server.ts"
  },
  "keywords": [
    "llm",
    "tokens",
    "context-window",
    "coding-agent",
    "claude-code",
    "codex",
    "proxy",
    "compression",
    "prompt-compression",
    "cost-optimization"
  ],
  "topics": [
    "llm",
    "context-window",
    "coding-agent",
    "prompt-compression",
    "llmops",
    "token-optimization"
  ],
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  }
}
